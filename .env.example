# ============================================================================
# AI Tech Radar - Environment Configuration (Vercel + Supabase / Local SQLite)
# Copy to `.env` for local dev, or paste into Vercel -> Project -> Environment Variables
# ============================================================================

HOST=127.0.0.1
PORT=8096

# 1. Supabase Postgres Database (Auto-injected if using Vercel Supabase Integration; falls back to SQLite locally)
SUPABASE_URL=
# Paste your Supabase Secret Key (`sb_secret_...`) OR legacy `service_role` JWT (`eyJ...`):
SUPABASE_SECRET_KEY=

# 2. Optional Admin Password (Recommended on public Vercel URL to prevent strangers triggering scans/translations)
RADAR_ADMIN_PASSWORD=

# 3. Official TypeSafe Jev API Key (https://console.typesafe.ai)
TYPESAFE_API_KEY=

# 4. X (Twitter) Web Session Cookies (x.com -> F12 -> Application -> Cookies)
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# 5. OpenRouter API Key (https://openrouter.ai/keys - manual DeepSeek V4 Flash digest)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
